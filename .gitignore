# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
build/
dist/
*.egg

# PyInstaller
*.spec.bak

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db

# Claude Code local session state (not project content)
.claude/

# Measurement data. Never in git: one acquisition is 32 MB, and a folder of
# them is the group's data, not this repo's source. The two folder rules below
# cover the app's default output paths; the '*.bin' rule catches an acquisition
# taken anywhere else in the tree (helpers/test_manual/, a scratch folder, a
# path someone typed into the Output Folder box).
*.bin
src/dapkel_rtp/functions/helpers/data/
src/dapkel_rtp/functions/helpers/live/

# The exe writes this next to every acquisition. Nothing reads it (see
# CHANGELOG: it is not a usable frame period), and a stale copy misleads humans.
frame_rate_cnt.txt
